{%- comment -%}
  UI Full-page Slideshow — sections/ui-fp-slideshow.liquid
  Add it to the homepage as the first section. Each block is one full-screen slide.
  Works with sections/ui-fp-header.liquid (which loads ui-fp.css and ui-fp.js).
{%- endcomment -%}

<div class="ui-fp" data-ui-fp>
  {%- for block in section.blocks -%}
    {%- assign intro = false -%}
    {%- if forloop.first and section.settings.intro_layout -%}{%- assign intro = true -%}{%- endif -%}
    <section
      class="ui-fp-slide{% if intro %} ui-fp-slide--intro{% endif %}"
      data-ui-fp-slide
      data-ui-fp-bg="{{ block.settings.bg }}"
      {{ block.shopify_attributes }}
    >
      <div class="ui-fp-slide__media">
        {%- if block.settings.image != blank -%}
          {%- liquid
            assign loading = 'lazy'
            if forloop.first
              assign loading = 'eager'
            endif
          -%}
          <picture>
            {%- if block.settings.image_mobile != blank -%}
              <source media="(max-width: 640px)" srcset="{{ block.settings.image_mobile | image_url: width: 1080 }}">
            {%- endif -%}
            {{ block.settings.image | image_url: width: 2400 | image_tag: sizes: '100vw', widths: '800, 1200, 1600, 2000, 2400', loading: loading, alt: block.settings.heading }}
          </picture>
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'ui-fp-slide__placeholder' }}
        {%- endif -%}
      </div>

      <div class="ui-fp-slide__caption">
        {%- if block.settings.heading != blank -%}<h2 class="ui-fp-slide__title">{{ block.settings.heading | escape }}</h2>{%- endif -%}
        {%- if block.settings.text != blank -%}<p class="ui-fp-slide__text">{{ block.settings.text | escape }}</p>{%- endif -%}
        {%- if block.settings.link_label != blank -%}
          <a class="ui-fp-slide__link" href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label | escape }}</a>
        {%- endif -%}
      </div>

      {%- if intro and section.settings.intro_search -%}
        <form class="ui-fp-slide__search" role="search" action="{{ routes.search_url }}" method="get">
          <label class="ui-hsearch__sr" for="ui-fp-search">Search</label>
          <input id="ui-fp-search" type="search" name="q" placeholder="Search" autocomplete="off">
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" aria-label="Submit search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 20 20"/></svg>
          </button>
        </form>
      {%- endif -%}
    </section>
  {%- endfor -%}
</div>

<style>
  .ui-fp-slide__placeholder { width: 100%; height: 100%; background: #3A3A38; fill: rgba(255,255,255,0.18); }
</style>

{% schema %}
{
  "name": "UI full-page slideshow",
  "class": "ui-fp-section",
  "max_blocks": 8,
  "settings": [
    { "type": "checkbox", "id": "intro_layout", "label": "First slide: centred caption", "default": true },
    { "type": "checkbox", "id": "intro_search", "label": "First slide: search line at the bottom", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)" },
        {
          "type": "select", "id": "bg", "label": "Image is mostly", "default": "dark",
          "info": "Sets the header, caption and counter colour for this slide.",
          "options": [ { "value": "dark", "label": "Dark (white text)" }, { "value": "light", "label": "Light (black text)" } ]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "New season" },
        { "type": "text", "id": "text", "label": "Text", "default": "A selection for the new season" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "UI full-page slideshow",
      "blocks": [ { "type": "slide" }, { "type": "slide" }, { "type": "slide" } ]
    }
  ]
}
{% endschema %}
