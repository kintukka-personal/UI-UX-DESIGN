{%- comment -%}
  UI Product Card (watch) — sections/ui-wcard.liquid
  Editorial product hero: giant wordmark, floating cut-out, colour swatches and
  an Add to bag that flies the product into the bag icon.

  Needs these theme assets (see the README):
    assets/ui-wcard.css          (this component's style.css)
    assets/ui-wcard.js           (this component's script.js)
    assets/ui-wcard-shopify.js   (shopify/ui-wcard-shopify.js)

  On a product page it shows that product. Anywhere else, pick a product in
  the section settings. Each "Colourway" block matches one value of the
  product's colour option and sets its swatch, transparent cut-out image and
  card colours. Values without a block use the theme swatch colour, the
  variant image and the default (Chrome, golden hour) card colours.
{%- endcomment -%}

{{ 'ui-wcard.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ui-wcard.js' | asset_url }}" defer></script>
<script src="{{ 'ui-wcard-shopify.js' | asset_url }}" defer></script>
{%- if section.settings.load_font -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&display=swap">
{%- endif -%}

{%- liquid
  assign p = product
  if section.settings.product != blank
    assign p = section.settings.product
  endif
  assign card_id = 'ui-wcard-' | append: section.id
-%}

<div class="ui-wcard-section" style="--ui-wcard-section-pt: {{ section.settings.padding_top }}px; --ui-wcard-section-pb: {{ section.settings.padding_bottom }}px;">
  <style>
    .ui-wcard-section { display: flex; justify-content: center; padding: var(--ui-wcard-section-pt) 16px var(--ui-wcard-section-pb); }
    .ui-wcard-section .ui-wcard__img { width: 100%; height: 100%; }
    #{{ card_id }} { max-width: {{ section.settings.max_width }}px; --ui-wcard-radius: {{ section.settings.radius }}; }
  </style>

  {%- if p == blank -%}
    {%- if request.design_mode -%}
      <p>UI product card (watch): pick a product in the section settings.</p>
    {%- endif -%}
  {%- else -%}
    {%- liquid
      assign current = p.selected_or_first_available_variant

      # Find the colour option by name (any of the comma-separated names).
      assign wanted = section.settings.option_name | downcase | split: ','
      assign color_option = false
      for option in p.options_with_values
        assign oname = option.name | downcase | strip
        for w in wanted
          assign ws = w | strip
          if oname == ws
            assign color_option = option
          endif
        endfor
      endfor

      assign wordmark = section.settings.wordmark | strip
      if wordmark == blank
        assign wordmark = p.title | split: ' ' | first
      endif
      assign wordmark = wordmark | upcase

      assign fallback_url = routes.all_products_collection_url
      if p.collections.size > 0
        assign fallback_url = p.collections.first.url
      endif

      assign imgs_html = ''
      assign swatches_html = ''
      assign theme_css = ''
      assign start_handle = 'default'
    -%}

    {%- if color_option -%}
      {%- assign idx = color_option.position | minus: 1 -%}
      {%- assign current_value = current.options[idx] -%}
      {%- for value in color_option.values -%}
        {%- liquid
          assign vname = value.name | default: value
          assign vname_down = vname | downcase | strip
          assign handle = vname | handle

          # The variant for this colour: the first available one, else the first.
          assign v = false
          for variant in p.variants
            if variant.options[idx] == vname
              if v == false
                assign v = variant
              elsif v.available == false and variant.available
                assign v = variant
              endif
            endif
          endfor

          assign b = false
          for block in section.blocks
            assign bval = block.settings.value | downcase | strip
            if bval == vname_down
              assign b = block
            endif
          endfor

          assign swatch = '#CCCCCC'
          if value.swatch.color
            assign swatch = value.swatch.color
          endif
          assign img = p.featured_image
          if v and v.featured_image
            assign img = v.featured_image
          endif
          if b
            assign swatch = b.settings.swatch
            if b.settings.image != blank
              assign img = b.settings.image
            endif
          endif

          assign is_current = false
          if vname == current_value
            assign is_current = true
            assign start_handle = handle
          endif
        -%}

        {%- capture img_html -%}
          {%- if img -%}
            <img
              class="ui-wcard__img{% if is_current %} is-active{% endif %}"
              data-colorway="{{ handle }}"
              src="{{ img | image_url: width: 1000 }}"
              srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 1000 }} 1000w, {{ img | image_url: width: 1400 }} 1400w"
              sizes="(max-width: 480px) 80vw, 360px"
              width="{{ img.width }}"
              height="{{ img.height }}"
              alt="{{ p.title | escape }} in {{ vname | escape }}"
              {% unless is_current %}aria-hidden="true"{% endunless %}
              loading="eager"
              decoding="async"
            >
          {%- endif -%}
        {%- endcapture -%}
        {%- assign imgs_html = imgs_html | append: img_html -%}

        {%- capture swatch_html -%}
          <label class="ui-wcard__swatch" style="--swatch: {{ swatch }}">
            <input
              type="radio"
              name="ui-wcard-colour-{{ section.id }}"
              value="{{ handle }}"
              {% if v %}data-variant-id="{{ v.id }}" data-price="{{ v.price | money_without_trailing_zeros | strip_html | escape }}" data-available="{{ v.available }}"{% if v.compare_at_price > v.price %} data-compare="{{ v.compare_at_price | money_without_trailing_zeros | strip_html | escape }}"{% endif %}{% endif %}
              {% if is_current %}checked{% endif %}
            >
            <span class="ui-wcard__dot" aria-hidden="true"></span>
            <span class="ui-wcard__swatch-name">{{ vname | escape }}</span>
          </label>
        {%- endcapture -%}
        {%- assign swatches_html = swatches_html | append: swatch_html -%}

        {%- if b -%}
          {%- capture block_css -%}
            #{{ card_id }}[data-colorway="{{ handle }}"] {
              --ui-wcard-stage-1: {{ b.settings.stage_1 }};
              --ui-wcard-stage-2: {{ b.settings.stage_2 }};
              --ui-wcard-stage-top: {{ b.settings.stage_top }};
              --ui-wcard-title: {{ b.settings.title }};
              --ui-wcard-specs: {{ b.settings.specs }};
              --ui-wcard-glow: {{ b.settings.glow }};
              --ui-wcard-cta-bg: {{ b.settings.cta_bg }};
              --ui-wcard-cta-bg-2: {{ b.settings.cta_bg_2 }};
              --ui-wcard-ring: {{ b.settings.ring }};
            }
          {%- endcapture -%}
          {%- assign theme_css = theme_css | append: block_css -%}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- liquid
        assign img = current.featured_image | default: p.featured_image
        assign b = section.blocks.first
        if b and b.settings.image != blank
          assign img = b.settings.image
        endif
      -%}
      {%- capture imgs_html -%}
        {%- if img -%}
          <img
            class="ui-wcard__img is-active"
            data-colorway="default"
            src="{{ img | image_url: width: 1000 }}"
            srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 1000 }} 1000w, {{ img | image_url: width: 1400 }} 1400w"
            sizes="(max-width: 480px) 80vw, 360px"
            width="{{ img.width }}"
            height="{{ img.height }}"
            alt="{{ p.title | escape }}"
            loading="eager"
            decoding="async"
          >
        {%- endif -%}
      {%- endcapture -%}
      {%- if b -%}
        {%- capture theme_css -%}
          #{{ card_id }} {
            --ui-wcard-stage-1: {{ b.settings.stage_1 }};
            --ui-wcard-stage-2: {{ b.settings.stage_2 }};
            --ui-wcard-stage-top: {{ b.settings.stage_top }};
            --ui-wcard-title: {{ b.settings.title }};
            --ui-wcard-specs: {{ b.settings.specs }};
            --ui-wcard-glow: {{ b.settings.glow }};
            --ui-wcard-cta-bg: {{ b.settings.cta_bg }};
            --ui-wcard-cta-bg-2: {{ b.settings.cta_bg_2 }};
            --ui-wcard-ring: {{ b.settings.ring }};
          }
        {%- endcapture -%}
      {%- endif -%}
    {%- endif -%}

    {%- if theme_css != blank -%}<style>{{ theme_css }}</style>{%- endif -%}

    <article
      class="ui-wcard"
      id="{{ card_id }}"
      data-ui-wcard
      data-colorway="{{ start_handle }}"
      data-sold-out-label="{{ section.settings.sold_out_label | escape }}"
    >
      {%- form 'product', p, class: 'ui-wcard__inner', data-ui-wcard-form: '' -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-ui-wcard-variant>
        <div class="ui-wcard__stage" aria-hidden="true"></div>

        {%- if section.settings.show_bar -%}
          <header class="ui-wcard__bar">
            <button class="ui-wcard__icon" type="button" aria-label="Back" data-ui-wcard-back data-fallback="{{ fallback_url }}">
              <svg viewBox="0 0 24 24"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
            </button>
            <a class="ui-wcard__icon" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}" data-ui-wcard-bag>
              <svg viewBox="0 0 24 24"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg>
              <span class="ui-wcard__badge" aria-hidden="true">{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span>
            </a>
          </header>
        {%- endif -%}

        {%- if section.settings.spec_left != blank or section.settings.spec_right != blank -%}
          <p class="ui-wcard__specs">
            <span>{{ section.settings.spec_left | escape }}</span>
            <span>{{ section.settings.spec_right | escape }}</span>
          </p>
        {%- endif -%}

        <h2 class="ui-wcard__title">
          <span aria-hidden="true">{{ wordmark | escape }}</span>
          <span class="ui-wcard__sr">{{ p.title | escape }}</span>
        </h2>

        <figure class="ui-wcard__media">
          <span class="ui-wcard__shadow" aria-hidden="true"></span>
          <span class="ui-wcard__float">{{ imgs_html }}</span>
        </figure>

        <div class="ui-wcard__body">
          <div class="ui-wcard__row">
            {%- liquid
              assign on_sale = false
              if current.compare_at_price > current.price
                assign on_sale = true
              endif
            -%}
            <p class="ui-wcard__price-label">
              <span class="ui-wcard__price-head"{% if on_sale %} hidden{% endif %}>{{ section.settings.price_label | escape }}</span>
              <span class="ui-wcard__price-row">
                <strong class="ui-wcard__price">{{ current.price | money_without_trailing_zeros }}</strong>
                <s class="ui-wcard__price-was"{% unless on_sale %} hidden{% endunless %}><span class="ui-wcard__sr">{{ section.settings.was_label | escape }} </span><span data-ui-wcard-was>{% if on_sale %}{{ current.compare_at_price | money_without_trailing_zeros }}{% endif %}</span></s>
              </span>
            </p>

            {%- if color_option and color_option.values.size > 1 -%}
              <fieldset class="ui-wcard__swatches">
                <legend class="ui-wcard__sr">{{ color_option.name | escape }}</legend>
                {{ swatches_html }}
              </fieldset>
            {%- endif -%}
          </div>

          <button class="ui-wcard__cta" type="submit" {% unless current.available %}disabled{% endunless %}>
            <span class="ui-wcard__cta-labels">
              <span class="ui-wcard__cta-add">{% if current.available %}<svg viewBox="0 0 24 24"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg>{{ section.settings.cta_label | escape }}{% else %}{{ section.settings.sold_out_label | escape }}{% endif %}</span>
              <span class="ui-wcard__cta-done" aria-hidden="true">
                <svg viewBox="0 0 16 16"><path d="M3 8.5l3.2 3.2L13 5"/></svg>{{ section.settings.added_label | escape }}
              </span>
            </span>
            {%- if section.settings.cta_note != blank -%}
              <span class="ui-wcard__cta-note">{{ section.settings.cta_note | escape }}</span>
            {%- endif -%}
          </button>
          <p class="ui-wcard__sr" role="status" aria-live="polite" data-ui-wcard-status></p>
        </div>
      {%- endform -%}
    </article>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "UI product card (watch)",
  "class": "ui-wcard-shopify-section",
  "settings": [
    {"type": "product", "id": "product", "label": "Product", "info": "On a product page, leave empty to use that page's product."},
    {"type": "text", "id": "wordmark", "label": "Wordmark", "info": "Large name behind the product. Leave empty to use the first word of the product title. Short words (3–5 letters) fill the card best."},
    {"type": "text", "id": "spec_left", "label": "Spec line, left", "default": "Quartz watch"},
    {"type": "text", "id": "spec_right", "label": "Spec line, right", "default": "FOSLN"},
    {"type": "text", "id": "option_name", "label": "Colour option name", "default": "Color, Colour, Dial", "info": "The product option the swatches use. Separate alternatives with commas."},
    {"type": "header", "content": "Text"},
    {"type": "text", "id": "price_label", "label": "Price label", "default": "Price", "info": "Shown above the price when the variant isn't on sale. On sale, the compare-at price is struck through next to the price instead."},
    {"type": "text", "id": "was_label", "label": "Screen-reader text before the old price", "default": "Was"},
    {"type": "text", "id": "cta_label", "label": "Button label", "default": "Add to cart"},
    {"type": "text", "id": "added_label", "label": "Added label", "default": "Added"},
    {"type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out"},
    {"type": "text", "id": "cta_note", "label": "Button note", "info": "Optional short line on the right of the button, such as \"Free returns\". Leave empty for a centred label."},
    {"type": "header", "content": "Layout"},
    {"type": "checkbox", "id": "show_bar", "label": "Show back and bag buttons", "default": true},
    {"type": "range", "id": "max_width", "label": "Card width", "min": 320, "max": 560, "step": 10, "unit": "px", "default": 430},
    {"type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "default": 28, "info": "In card units (1/390 of the card width)."},
    {"type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40},
    {"type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40},
    {"type": "checkbox", "id": "load_font", "label": "Load Manrope from Google Fonts", "default": true, "info": "Turn off if the theme already loads it, or if you set --ui-wcard-font to the theme's font."}
  ],
  "blocks": [
    {
      "type": "colourway",
      "name": "Colourway",
      "settings": [
        {"type": "text", "id": "value", "label": "Colour value", "default": "Chrome", "info": "Must match the product's colour option value exactly (case doesn't matter)."},
        {"type": "color", "id": "swatch", "label": "Swatch", "default": "#C9CDD2"},
        {"type": "image_picker", "id": "image", "label": "Cut-out image", "info": "A transparent PNG or WebP of the product, portrait, with the product filling the frame. Falls back to the variant image."},
        {"type": "header", "content": "Card colours"},
        {"type": "color", "id": "stage_1", "label": "Stage glow (centre)", "default": "#3A2F22"},
        {"type": "color", "id": "stage_2", "label": "Stage (edges)", "default": "#14110E"},
        {"type": "color", "id": "stage_top", "label": "Stage top (ombré)", "default": "#070605"},
        {"type": "color", "id": "glow", "label": "Light glow (upper left)", "default": "#C99A4E"},
        {"type": "color", "id": "title", "label": "Wordmark and icons", "default": "#EADBB9"},
        {"type": "color", "id": "specs", "label": "Spec line", "default": "#B5935A"},
        {"type": "color", "id": "cta_bg", "label": "Button (light end)", "default": "#DDBB76"},
        {"type": "color", "id": "cta_bg_2", "label": "Button (dark end)", "default": "#A27A3C"},
        {"type": "color", "id": "ring", "label": "Selected swatch ring", "default": "#CFAE6C"}
      ]
    }
  ],
  "presets": [
    {
      "name": "UI product card (watch)",
      "blocks": [
        {"type": "colourway", "settings": {"value": "Chrome", "swatch": "#C9CDD2", "stage_1": "#3A2F22", "stage_2": "#14110E", "stage_top": "#070605", "glow": "#C99A4E", "title": "#EADBB9", "specs": "#B5935A", "cta_bg": "#DDBB76", "cta_bg_2": "#A27A3C", "ring": "#CFAE6C"}},
        {"type": "colourway", "settings": {"value": "Onyx", "swatch": "#18191B", "stage_1": "#24221F", "stage_2": "#0C0B0A", "stage_top": "#030303", "glow": "#6E5534", "title": "#E4E1DA", "specs": "#8F8A80", "cta_bg": "#E9E4DA", "cta_bg_2": "#A9A399", "ring": "#D9D3C7"}}
      ]
    }
  ]
}
{% endschema %}
